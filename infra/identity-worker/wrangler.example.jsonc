{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "YOUR_IDENTITY_WORKER_NAME",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "YOUR_D1_NAME",
      "database_id": "YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}

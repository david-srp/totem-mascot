# 复制为 .env。这里的值都属于当前 Builder，不要提交 .env。

# ZooWork App → Settings → API Keys → Create API Key。
# 第一次 publish 会在这个 key 所属 organization 创建 Skill；以后发布新版本。
ZOOWORK_API_KEY=zct_your_key
# 默认连接 ZooWork production。只有连接其他部署时才设置 ZOOWORK_BASE_URL。
# ZOOWORK_BASE_URL=https://your-zoowork-api.example.com/service/v1

# Wrangler 使用这两个值操作当前 Builder 自己的 Cloudflare account。
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# App Worker 和 Identity Worker 之间共用的随机 token。
# 部署时分别写成 TOTEM_IDENTITY_SERVICE_TOKEN 和 TOTEM_SERVICE_TOKEN secret。
TOTEM_IDENTITY_SERVICE_TOKEN=generate_a_random_service_token

# 本地开发不经过 Cloudflare Access，仅 localhost 生效。
TOTEM_DEV_EMAIL=you@example.com

# 不配置 agent id。每个用户第一次建项目时，应用自动创建一个专属 Agent。

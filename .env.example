# 从 ZooClaw App → Settings → API Keys → Create API Key 拿，只显示一次
ZOOCLAW_API_KEY=zct_你的密钥

# Cloudflare Access（生产环境）
CF_ACCESS_TEAM_DOMAIN=rebyte-admin.cloudflareaccess.com
CF_ACCESS_AUD=Access application 的 AUD
TOTEM_ALLOWED_EMAIL_DOMAIN=srp.one

# D1 identity registry Worker。service token 只存在服务端。
TOTEM_IDENTITY_URL=https://totem-identity.cctools.workers.dev
TOTEM_IDENTITY_SERVICE_TOKEN=随机密钥

# 本地开发不经过 Cloudflare Access，仅 localhost 生效。
TOTEM_DEV_EMAIL=你的名字@srp.one

# 不需要配 agent id：agent 是每个用户第一次建项目时自动创建的（见 api/_agent.js），
# 但要先跑一次 scripts/upload-skill.mjs 把技能包传上去。

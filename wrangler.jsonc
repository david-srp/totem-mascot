{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "totem",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/app", "/guide"]
  },
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "rebyte-admin.cloudflareaccess.com",
    "CF_ACCESS_AUD": "b02c87303dd1f1a387938376e3e85c9b2e40d53b714b8de7f9abcd6e05737465",
    "TOTEM_ALLOWED_EMAIL_DOMAIN": "srp.one",
    "TOTEM_IDENTITY_URL": "https://totem-identity.cctools.workers.dev"
  }
}
